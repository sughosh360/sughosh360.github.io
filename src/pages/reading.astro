---
import Base from '../layouts/Base.astro';
import BookList from '../components/BookList.astro';
import papers from '../data/papers.json';
import books from '../data/books.json';
import type { Book } from '../data/site';

const subjectNames: Record<string, string> = {
  'cs.DB': 'Databases',
  'cs.LO': 'Logic in Computer Science',
};
const subjects = [...new Set(papers.flatMap(paper => paper.subjects))].sort();
const keywords = [...new Set(papers.flatMap(paper => paper.keywords))].sort();
const sections = [
  { heading: 'Research papers', refs: papers.filter(paper => !paper.kind) },
  { heading: 'Other cited sources', refs: papers.filter(paper => paper.kind) },
];
const groups = [
  { status: 'reading', heading: 'Currently reading' },
  { status: 'next', heading: 'Up next' },
  { status: 'read', heading: 'Read' },
] as const;
---
<Base title="Papers & reading | Sughosh Kaushik" description="Browse the bibliography of SQL Execution of Smoked Duck by arXiv subject and topic keyword, alongside my bookshelf.">
  <header class="intro">
    <p class="eyebrow">Field notes / Reading shelf</p>
    <h1>Papers &amp; reading</h1>
    <p class="lead">The research behind my DuckDB lineage thesis, plus the books on my shelf.</p>
  </header>
  <section aria-labelledby="papers">
    <h2 id="papers">Papers behind the thesis</h2>
    <p>Start with Smoke [10] for the lineage problem and DuckDB [11] for the engine, then read the <a href="/notes/lineage-in-duckdb/">case study</a>. Reference numbers match the bibliography in <a href="https://github.com/sughosh360/Thesis/blob/master/Smoked_Duck.pdf">SQL Execution of Smoked Duck</a>.</p>
    <p class="guide">“arXiv subject” comes from the linked preprint. “Shelf subject” uses the same <a href="https://arxiv.org/category_taxonomy">arXiv taxonomy</a> but is assigned here. Keywords are shelf tags, not arXiv metadata.</p>
    <div class="tools" data-tools hidden>
      <label for="topic">Browse by subject or keyword</label>
      <select id="topic">
        <option value="">All references</option>
        <optgroup label="Subjects">
          {subjects.map(code => <option value={code}>{code} · {subjectNames[code]}</option>)}
        </optgroup>
        <optgroup label="Keywords">
          {keywords.map(keyword => <option value={keyword}>{keyword}</option>)}
        </optgroup>
      </select>
      <span class="muted" role="status" data-count>{papers.length} references</span>
    </div>
    {sections.map(({ heading, refs }) => (
      <div class="group" data-group>
        <h3>{heading}</h3>
        <div class="papers">
          {refs.map(paper => (
            <article id={`ref-${paper.ref}`} data-tags={JSON.stringify([...paper.subjects, ...paper.keywords])}>
              <p class="eyebrow">[{paper.ref}] / {paper.kind ?? 'Paper'}</p>
              <h4><a href={paper.url}>{paper.title}</a></h4>
              <p class="muted">{paper.citation}</p>
              <p>{paper.note}</p>
              {paper.subjects.length > 0 && (
                <p class="subjects">
                  {paper.arxiv ? <a href={`https://arxiv.org/abs/${paper.arxiv}`}>arXiv subject</a> : 'Shelf subject'}:
                  {' '}{paper.subjects.map(code => `${code} (${subjectNames[code]})`).join('; ')}
                </p>
              )}
              <ul class="tags" aria-label="Keywords">
                {paper.keywords.map(keyword => <li>{keyword}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>
  <section aria-labelledby="books">
    <h2 id="books">Bookshelf</h2>
    {groups.map(({ status, heading }) =>
      <BookList heading={heading} books={(books as Book[]).filter(book => book.status === status)} open={status === 'reading'} />
    )}
  </section>
</Base>
<script>
  const topic = document.querySelector<HTMLSelectElement>('#topic');
  const tools = document.querySelector<HTMLElement>('[data-tools]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  if (topic && tools && count) {
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'), group => ({
      group, cards: Array.from(group.querySelectorAll<HTMLElement>('[data-tags]'), card => ({
        card, tags: JSON.parse(card.dataset.tags!) as string[],
      })),
    }));
    const filter = () => {
      let visible = 0;
      for (const { group, cards } of groups) {
        let matches = 0;
        for (const { card, tags } of cards) {
          card.hidden = !!topic.value && !tags.includes(topic.value);
          if (!card.hidden) matches++;
        }
        group.hidden = matches === 0;
        visible += matches;
      }
      count.textContent = `${visible} reference${visible === 1 ? '' : 's'}`;
    };
    topic.addEventListener('change', filter);
    filter();
    tools.hidden = false;
  }
</script>
<style>
  .intro { padding-block: 3rem 1rem; }
  .intro h1 { font-size: clamp(2.8rem, 6vw, 4.5rem); margin: .5rem 0; }
  .papers { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 1rem; margin-top: 1.2rem; }
  article { background: var(--card); border: 1px solid var(--border); border-radius: .6rem; padding: 1.25rem; }
  .guide, .subjects { color: var(--muted); font-size: .9rem; }
  .tools { padding: 1rem; border: 1px solid var(--border); border-radius: .5rem; background: var(--wash); }
  .tools:not([hidden]) { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; }
  label { font-weight: 600; }
  select { max-width: 100%; font: inherit; background: var(--card); color: var(--fg); padding: .4rem; border: 1px solid var(--border); border-radius: .3rem; }
  .group { margin-top: 2rem; }
  article h4 { margin: .6rem 0 .3rem; font-size: 1.1rem; line-height: 1.35; }
  article p { margin: .4rem 0 0; }
  article .muted { font-size: .88rem; }
  article .subjects { margin-top: 1rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .35rem; list-style: none; margin: .6rem 0 0; padding: 0; }
  .tags li { padding: .15rem .55rem; font-size: .78rem; border-radius: 1rem; background: var(--wash); }
  section > p { max-width: 60ch; }
</style>
