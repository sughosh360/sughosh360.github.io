---
import Base from '../layouts/Base.astro';
import BookList from '../components/BookList.astro';
import publications from '../data/publications.json';
import papers from '../data/papers.json';
import books from '../data/books.json';
import type { Book } from '../data/site';

const groups = [
  { status: 'reading', heading: 'Currently reading' },
  { status: 'next', heading: 'Up next' },
  { status: 'read', heading: 'Read' },
] as const;
const topics = [...new Set([...publications, ...papers].flatMap(paper => paper.topics))].sort();
---
<Base title="Publications, papers & reading | Sughosh Kaushik" description="Explore Sughosh Kaushik’s publications, SIGMOD poster and master’s thesis, then search the full thesis bibliography by topic, author, year, or venue.">
  <header class="intro">
    <h1>Papers &amp; reading</h1>
    <p class="lead">My research on data lineage, query execution, and software testing, alongside the sources I cited in my Columbia thesis.</p>
    <nav class="links" aria-label="Research collections">
      <a href="/reading/#publications">Publications &amp; presentations ({publications.length})</a>
      <a href="/reading/#papers">Thesis references ({papers.length})</a>
      <a href="#books">Bookshelf</a>
    </nav>
  </header>

  <div class="search-area">
    <form id="paper-search" role="search" aria-label="Search publications and thesis references" hidden>
      <label>Search papers and presentations
        <input name="q" type="search" placeholder="Title, author, keyword, year, or venue" autocomplete="off" />
      </label>
      <label>Research topic
        <select name="topic">
          <option value="">All topics</option>
          {topics.map(topic => <option>{topic}</option>)}
        </select>
      </label>
      <button type="reset">Clear filters</button>
    </form>
    <p role="status" class="status">{publications.length} authored works and {papers.length} thesis references</p>
  </div>

  <section aria-labelledby="publications" data-collection="works">
    <h2 id="publications">Publications &amp; presentations</h2>
    <ul class="works">
      {publications.map(work => (
        <li id={work.id} data-topics={JSON.stringify(work.topics)}>
          <article>
            <p class="publication">{work.year} · {work.type}</p>
            <h3><a href={work.links[0].url}>{work.title}</a></h3>
            <p class="authors">{work.authors}</p>
            <p class="venue">{work.venue}</p>
            <p class="note">{work.note}</p>
            <p class="resource-links">{work.links.map(link => <a href={link.url}>{link.label}</a>)}</p>
          </article>
          {work.id === 'sigmod-src-poster' && <a class="poster-preview" href={work.links[0].url} aria-label="Open the full SIGMOD research poster PDF">
            <img src="/sigmod-src-poster.webp" width="760" height="507" loading="lazy" alt="Research poster with DuckDB query plans and TPC-H lineage timing results" />
          </a>}
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="papers" class="archive" data-collection="references">
    <h2 id="papers">Thesis bibliography</h2>
    <p>All {papers.length} references from <cite>SQL Execution of Smoked Duck</cite>, numbered as they appear in the thesis.</p>
    <ol class="catalog" aria-label="Thesis references">
      {papers.map(paper => (
        <li id={`ref-${paper.number}`} data-topics={JSON.stringify(paper.topics)}>
          <span class="ref" aria-label={`Reference ${paper.number}`}>[{paper.number}]</span>
          <article>
            <p class="publication">{paper.venue}{paper.year && ` · ${paper.year}`}</p>
            <h3><a href={paper.url}>{paper.title}</a></h3>
            <p class="authors">{paper.authors}</p>
            <p class="note">{paper.note}</p>
            {paper.annotation && <p class="source-note">{paper.annotation}</p>}
            {paper.number === 7 && <a class="follow-up" href="https://doi.org/10.1145/3555041.3589731">Related demo · SQLStepper · Haneen Mohammed, Charlie Summers, Sughosh Kaushik, Eugene Wu · SIGMOD 2023</a>}
            <ul class="tags" aria-label="Topics and keywords">
              {[...paper.topics, ...paper.keywords].map(tag => <li>{tag}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </section>
  <section aria-labelledby="books">
    <h2 id="books">Bookshelf</h2>
    {groups.map(({ status, heading }) =>
      <BookList heading={heading} books={(books as Book[]).filter(book => book.status === status)} open={status === 'reading'} />
    )}
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#paper-search')!;
  const query = form.querySelector('input')!;
  const topic = form.querySelector('select')!;
  const status = document.querySelector('.status')!;
  // Fold accents and punctuation so "Muller", "why not", and "1805.11517" are searchable.
  function normalize(value: string) {
    return value.toLowerCase().normalize('NFKD').replace(/\p{M}/gu, '').replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
  }
  const collections = [...document.querySelectorAll<HTMLElement>('[data-collection]')].map(section => ({
    section,
    records: [...section.querySelectorAll<HTMLElement>('li[data-topics]')].map(element => {
      const topics = JSON.parse(element.dataset.topics!) as string[];
      const fields = Array.from(element.querySelectorAll('p, h3, .tags li, .ref, .follow-up'), field => field.textContent);
      return { element, topics, text: normalize([...fields, ...topics].join(' ')) };
    }),
  }));

  function filterRecords() {
    const terms = normalize(query.value).split(/\s+/).filter(Boolean);
    const counts = collections.map(({section, records}) => {
      let count = 0;
      for (const record of records) {
        const matches = (!topic.value || record.topics.includes(topic.value)) && terms.every(term => record.text.includes(term));
        record.element.hidden = !matches;
        if (matches) count++;
      }
      section.hidden = count === 0;
      return count;
    });
    const [works, references] = counts;
    status.textContent = works || references
      ? `${works} authored ${works === 1 ? 'work' : 'works'} and ${references} thesis ${references === 1 ? 'reference' : 'references'}`
      : 'No matching publications or references. Try another term or clear the filters.';
  }
  function restore() {
    const params = new URL(location.href).searchParams;
    query.value = params.get('q') ?? '';
    topic.value = params.get('topic') ?? '';
    if (topic.selectedIndex < 0) topic.selectedIndex = 0;
    filterRecords();
  }
  function update() {
    filterRecords();
    const url = new URL(location.href);
    for (const control of [query, topic]) {
      if (control.value) url.searchParams.set(control.name, control.value);
      else url.searchParams.delete(control.name);
    }
    history.replaceState(history.state, '', url);
  }
  restore();
  form.hidden = false;
  query.addEventListener('input', update);
  topic.addEventListener('change', update);
  form.addEventListener('submit', event => { event.preventDefault(); update(); });
  form.addEventListener('reset', event => {
    event.preventDefault();
    query.value = '';
    topic.value = '';
    update();
    query.focus();
  });
  window.addEventListener('pageshow', restore);
  window.addEventListener('popstate', restore);
</script>

<style>
  .intro { padding: clamp(2rem, 5vw, 3.5rem) 0 1.6rem; }
  .intro h1 { font-size: clamp(2.9rem, 6vw, 4.75rem); margin: 0; line-height: 1.08; }
  .intro .lead { margin: .85rem 0; max-width: 62ch; }
  .links, .tags, .resource-links { display: flex; flex-wrap: wrap; gap: .4rem 1rem; }
  .links a { font-weight: 600; }
  .works { padding: 0; margin: 0; list-style: none; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 25rem), 1fr)); }
  .works > li { padding: 1.1rem 1.3rem; border: 1px solid var(--border); border-top: 3px solid var(--accent); border-radius: .45rem; background: var(--card); }
  #sigmod-src-poster { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, 30%); align-items: center; gap: 1rem 2rem; }
  #sigmod-src-poster[hidden] { display: none; }
  .poster-preview { display: block; }
  .poster-preview img { display: block; width: 100%; height: auto; border: 1px solid var(--border); }
  @media (max-width: 42rem) { #sigmod-src-poster { grid-template-columns: 1fr; } }
  .works .venue { margin: .3rem 0; color: var(--muted); font-size: .95rem; }
  .works .resource-links { margin: .8rem 0 0; }
  .archive { border-top: 1px solid var(--border); }
  form { background: var(--wash); padding: 1rem; border-radius: .65rem; display: flex; align-items: end; flex-wrap: wrap; gap: .85rem; }
  form[hidden], .catalog > li[hidden] { display: none; }
  label { display: grid; gap: .3rem; font-weight: 600; min-width: 0; }
  label:first-child { flex: 2 1 18rem; }
  label:nth-child(2) { flex: 1 1 12rem; }
  input, select, button { font: inherit; padding: .6rem .8rem; border: 1px solid var(--muted); border-radius: .35rem; background: var(--card); color: var(--fg); min-width: 0; }
  button { cursor: pointer; background: transparent; }
  button:hover { color: var(--accent); text-decoration: underline; }
  .status, .publication, .ref { font: 500 .85rem/1.5 var(--mono); }
  .status { margin: 1.25rem 0 .5rem; color: var(--muted); }
  .catalog { list-style: none; margin: 0; padding: 0; }
  .catalog > li { display: grid; grid-template-columns: 3.3rem minmax(0,1fr); gap: .6rem; padding: 1.4rem 0; border-top: 1px solid var(--border); }
  .ref { color: var(--accent); padding-top: .1rem; }
  article { max-width: 53rem; }
  .publication { color: var(--muted); margin: 0; }
  h3 { font: 500 clamp(1.35rem, 2.3vw, 1.7rem)/1.25 Georgia, serif; margin: .35rem 0; }
  h3 a { color: var(--fg); text-decoration: none; }
  h3 a:hover { text-decoration: underline; color: var(--accent); }
  .authors { margin: .3rem 0; }
  .note { margin: .65rem 0; color: var(--muted); }
  .source-note { padding-inline-start: .75rem; border-left: 2px solid var(--accent); color: var(--muted); margin: .75rem 0; font-size: .95rem; }
  .tags { list-style: none; padding: 0; margin: .75rem 0 0; gap: .3rem .45rem; }
  .tags li { background: var(--wash); color: var(--accent); padding: .15rem .5rem; border-radius: .25rem; font-size: .85rem; }
  @media (max-width: 45rem) { .catalog > li { grid-template-columns: 2rem minmax(0, 1fr); } }
</style>
