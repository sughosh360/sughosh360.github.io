---
import TechnologyIndex from '../components/TechnologyIndex.astro';
import ImpactHighlights from '../components/ImpactHighlights.astro';
import papers from '../data/papers.json';
import publications from '../data/publications.json';
import projects from '../data/projects.json';
import experience from '../data/experience.json';
import Base from '../layouts/Base.astro';
import LineageFigure from '../components/LineageFigure.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { site } from '../data/site';
---

<Base>
  <section id="about" class="hero">
    <div>
      <p class="eyebrow">{site.role}</p>
      <h1>Sughosh <em>Kaushik</em></h1>
      <p class="lead">{site.bio}</p>
      <div class="actions">
        <a class="button" href={site.recruitingUrl}>Email me about a role</a>
        <a href="#experience">View experience</a>
      </div>
    </div>
    <ImpactHighlights group="aws" />
  </section>

  <ImpactHighlights group="other" />

  <section id="now" class="now">
    <div>
      <p class="eyebrow">Current project · <time datetime="2026-11">November 2026</time></p>
      <h2>Connecting DuckDB to Redshift</h2>
    </div>
    <div>
      <p>I’m working on a DuckDB extension that lets users run Amazon Redshift queries from DuckDB. The public design discussion shows how a DuckDB connection could attach a Redshift cluster or Serverless workgroup.</p>
      <a href="https://github.com/duckdb/duckdb-aws/pull/252">Read the integration discussion <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="projects">
    <h2>Projects &amp; database notes</h2>
    <div class="grid">
      {projects.map(project => project.id === 'thesis' ? (
        <article class="thesis-project">
          <div>
            <p class="eyebrow">{project.tags.join(' · ')}</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <a href={project.url}>Read the thesis case study</a>
          </div>
          <LineageFigure />
        </article>
      ) : <ProjectCard project={project} />)}
    </div>
  </section>

  <TechnologyIndex />

  <section id="experience">
    <h2>Experience</h2>
    <ExperienceTimeline items={experience} />
  </section>

  <section id="education">
    <h2>Education &amp; recognition</h2>
    <div class="grid">
      <details class="credential" id="columbia">
        <summary>
          <strong>Columbia University</strong>
          <span>M.S. in Computer Science · 2022</span>
        </summary>
        <p>Advised by Eugene Wu, I instrumented DuckDB’s SQL operators to capture lineage and built indexes to query it interactively.</p>
        <ul>
          <li>Placed third in the SIGMOD 2022 Student Research Competition.</li>
          <li>Received a Columbia Engineering Graduate Student Council grant for research on lineage in vectorized engines.</li>
          <li>Selected for the 2022 Olam Ventures Startup Challenge fellowship.</li>
        </ul>
        <a href="/notes/lineage-in-duckdb/">Explore the thesis and research poster</a>
      </details>
      <details class="credential" id="rvce">
        <summary>
          <strong>R.V. College of Engineering</strong>
          <span>B.E. in Computer Science · 2017</span>
        </summary>
        <ul>
          <li>Graduated in the top 5% of my class and earned the graduating class’s best project award.</li>
          <li>Represented the college on a team that qualified among the top 50 for the ACM ICPC India finals.</li>
        </ul>
      </details>
    </div>
  </section>

  <section id="reading" aria-labelledby="publications">
    <h2 id="publications">Publications &amp; presentations</h2>
    <ul class="pub-list">
      {publications.map(work => <li>
        <span>{work.year} · {work.type}</span>
        <a href={`/reading/#${work.id}`}>{work.title}</a>
      </li>)}
    </ul>
    <div class="actions">
      <a href="/reading/#publications">View publication details</a>
      <a href="/reading/#papers">Browse all {papers.length} thesis references</a>
    </div>
  </section>

  <section id="contact" class="contact">
    <div>
      <h2>Have a role in mind?</h2>
      <p>Tell me about the team, the engineering problem, and a good time for a call.</p>
    </div>
    <div class="contact-links">
      <a class="email" href={site.recruitingUrl}>{site.email}</a>
      <div class="actions">
        {site.links.map(link => <a href={link.url}>{link.label}</a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero, .now { display: grid; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .hero { padding-block: clamp(2.25rem, 5.4vw, 4.2rem); grid-template-columns: 1.06fr .94fr; }
  .hero h1 { margin: .6rem 0 1.1rem; font-size: clamp(3.7rem, 7.5vw, 6rem); line-height: .98; }
  .hero h1 em { display: block; color: var(--accent); font-weight: inherit; }
  .hero .eyebrow { font-size: .85rem; }
  .hero .lead { max-width: 34rem; }
  .now { grid-template-columns: .85fr 1.15fr; padding: clamp(1.3rem, 3vw, 2.3rem); background: var(--wash); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: .65rem; }
  .now h2 { margin-bottom: 0; }
  .now p:not(.eyebrow) { margin: 0 0 .75rem; }
  .now + section { border-top: 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem; }
  .thesis-project { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 4vw, 3rem); align-items: center; margin-bottom: .5rem; }
  .thesis-project h3 { margin: 0; font-size: clamp(1.4rem, 2.2vw, 1.9rem); }
  .thesis-project p:not(.eyebrow) { color: var(--muted); margin: .55rem 0 .9rem; }
  #education .grid { align-items: start; }
  .credential { padding: 1rem 1.15rem; border: 1px solid var(--border); border-radius: .75rem; background: var(--card); }
  .credential summary { cursor: pointer; }
  .credential summary::marker { color: var(--accent); }
  .credential summary span { display: block; margin-inline-start: 1rem; color: var(--muted); }
  .credential ul { padding-inline-start: 1.25rem; }
  .credential li + li { margin-top: .35rem; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem 1.2rem; }
  .hero .actions { margin-top: 1.5rem; }
  .pub-list { list-style: none; margin: 0 0 1.2rem; padding: 0; }
  .pub-list li { display: grid; grid-template-columns: minmax(12rem, .55fr) 1.45fr; gap: .25rem 1rem; align-items: baseline; border-top: 1px solid var(--border); padding: .7rem 0; }
  .pub-list span { font-size: .9rem; color: var(--muted); }
  @media (max-width: 40rem) { .pub-list li { grid-template-columns: 1fr; } }
  .contact { margin-block: 1rem 2.5rem; padding: clamp(1.4rem, 4vw, 3rem); border: 0; border-radius: .8rem; background: #183931; color: #eff6e9; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem; }
  .contact h2 { margin: 0; }
  .contact p { max-width: 34rem; margin: .6rem 0 0; color: #d2dfd4; }
  .contact a { color: #d1eead; }
  .contact a:focus-visible { outline-color: #e3f8c7; }
  .contact-links { min-width: 0; }
  .contact-links .email { font-size: clamp(1.08rem, 2vw, 1.4rem); overflow-wrap: anywhere; }
  .contact-links .actions { margin-top: .6rem; font-size: .95rem; }
  @media (max-width: 48rem) { .hero, .now, .thesis-project { grid-template-columns: 1fr; } }
</style>
