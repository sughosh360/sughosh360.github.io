---
import booksJson from '../data/books.json';
import projectsJson from '../data/projects.json';
import experienceJson from '../data/experience.json';
import Base from '../layouts/Base.astro';
import BookList from '../components/BookList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { site, type Book, type Project, type Experience } from '../data/site';

const books = booksJson as Book[];
const projects: Project[] = projectsJson;
const experience: Experience[] = experienceJson;
const byStatus = (status: 'reading' | 'read' | 'next') =>
  books.filter((book) => book.status === status);
---

<Base>
  <section id="about">
    <h1>Hi, I'm {site.name.split(' ')[0]}.</h1>
    <p class="lead muted">{site.bio}</p>
  </section>

  <section id="experience">
    <h2>Experience</h2>
    <p class="muted">I work on databases, query engines, and the systems behind them.</p>
    <ExperienceTimeline items={experience} />
  </section>

  <section id="projects">
    <h2>Projects</h2>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section id="reading">
    <h2>Reading</h2>
    <BookList heading="Currently reading" books={byStatus('reading')} open />
    <BookList heading="Up next" books={byStatus('next')} />
    <BookList heading="Read" books={byStatus('read')} />
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <ul class="links">
      {
        site.links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  #about {
    padding-top: 4rem;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    margin: 0 0 0.75rem;
  }
  .lead {
    font-size: 1.15rem;
    margin: 0;
  }
  #experience p {
    margin-top: 0.4rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }
</style>
