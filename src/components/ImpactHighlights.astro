---
const highlights = [
  {
    company: 'Eightfold AI',
    metric: '10×',
    result: 'analytics performance',
    detail: 'Dashboards were timing out. I moved them to QuickSight backed by materialized views, bringing response times down to five seconds.',
  },
  {
    company: 'SAP SuccessFactors',
    metric: '50%',
    result: 'lower API memory use',
    detail: 'I worked with two architects to rebuild CRUD APIs for the Metadata Framework. The new implementation used half the memory and improved performance sixfold.',
  },
  {
    company: 'Eightfold AI',
    metric: '30%',
    result: 'shorter analytics jobs',
    detail: 'I implemented a new Spark pipeline for analytics jobs. It cut runtime by 30% on a team responsible for moving customer data from RDS to Redshift.',
  },
];
---
<section aria-labelledby="impact-title" class="impact">
  <h2 id="impact-title">Engineering impact</h2>
  <div class="outcomes">
    {highlights.map(item => (
      <details>
        <summary>
          <span class="company">{item.company}</span>
          <strong>{item.metric}</strong>
          <span class="result">{item.result}</span>
          <span class="read"><span class="closed-label">See the work</span><span class="open-label">Hide details</span><i aria-hidden="true"></i></span>
        </summary>
        <p>{item.detail}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .impact { padding: 1.75rem 0 2.25rem; }
  h2 { font: 650 1rem/1.5 system-ui, sans-serif; letter-spacing: 0; margin: 0 0 1rem; }
  .outcomes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; align-items: start; }
  details { border-top: 2px solid var(--accent); }
  summary { cursor: pointer; display: grid; padding-top: 1rem; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .company { font: 600 .85rem/1.5 var(--mono); color: var(--muted); }
  strong { font: 500 clamp(2.75rem, 4.7vw, 4rem)/1.18 Georgia, serif; letter-spacing: -.045em; color: var(--fg); }
  .result { font-weight: 600; }
  .read { display: inline-flex; align-items: center; gap: .4rem; margin-top: .65rem; font-size: .9rem; color: var(--accent); }
  .read i::before { content: '+'; font-style: normal; }
  summary:hover .read { text-decoration: underline; }
  details[open] i::before { content: '−'; }
  .open-label, details[open] .closed-label { display: none; }
  details[open] .open-label { display: inline; }
  p { color: var(--muted); margin: .55rem 0 0; }
  @media (max-width: 40rem) {
    .outcomes { grid-template-columns: 1fr; gap: 1rem; }
    summary { grid-template-columns: 5.5rem 1fr; column-gap: .9rem; }
    strong { grid-column: 1; grid-row: 1 / span 3; align-self: center; }
    .company, .result, .read { grid-column: 2; }
    .read { margin-top: .2rem; }
  }
</style>
