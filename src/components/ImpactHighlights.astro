---
interface Props {
  group: 'aws' | 'other';
}
const { group } = Astro.props;
const isAws = group === 'aws';
const titleId = isAws ? 'aws-work-title' : 'impact-title';
const highlights = {
  aws: [
    {
      company: 'Redshift zero-ETL · 42 AWS Regions',
      result: 'Removing the shared lock behind fleet-wide restarts',
      detail: 'Customer clusters across the zero-ETL fleet were restarting. Catalog updates and maintenance competed for the same lock. I redesigned how those operations coordinate so each could make progress independently.',
    },
    {
      company: 'Redshift Serverless · 4 RPU',
      result: 'Correcting replication for 15+ customers',
      detail: 'Uneven work distribution stalled replication and produced incorrect results. The scheduling rule was shared across workgroups. I changed it to account for available compute, added tracing, and verified the rollout with integration tests.',
    },
    {
      company: 'Redshift zero-ETL',
      result: 'Customer onboarding resumed after a cross-service fix',
      detail: 'A customer could not start replicating data into Redshift. I led the investigation and isolated a difference in how two services interpreted Parquet dates and timestamps. With the failure narrowed to that boundary, the teams resolved it and ingestion could begin.',
    },
    {
      company: 'Aurora MySQL',
      result: 'Read performance restored in MySQL 8.4',
      detail: 'An engine regression had slowed the threads that handle read I/O. Correcting it restored read performance in Aurora MySQL 8.4.',
    },
  ],
  other: [
    {
      company: 'Eightfold AI',
      result: 'From dashboard timeouts to results in five seconds',
      detail: 'I proposed moving QuickSight dashboards to materialized views so repeated analytical queries could read precomputed results. The change brought dashboard response times to five seconds for analytics customers. Overall analytics performance improved 10×.',
    },
    {
      company: 'SAP SuccessFactors',
      result: 'Half the API memory for enterprise workloads',
      detail: 'Two architects and I redesigned the CRUD APIs that support enterprise onboarding. Memory use fell by 50%, supporting customers with more than one million employees. I benchmarked the old and new programming models and shared the results so 12 module teams could evaluate adoption.'
    },
  ],
};
---
<section aria-labelledby={titleId} class:list={['impact', { 'aws-work': isAws }]}>
  <h2 id={titleId}>{isAws ? 'Selected work at AWS' : 'Engineering impact'}</h2>
  <div class="outcomes">
    {highlights[group].map(item => (
      <details>
        <summary>
          <span class="company">{item.company}</span>
          <strong>{item.result}</strong>
          <span class="read"><span class="closed-label">See the work</span><span class="open-label">Hide details</span><i aria-hidden="true"></i></span>
        </summary>
        <p>{item.detail}</p>
      </details>
    ))}
  </div>
  {isAws && <a class="case-link" href="/notes/redshift-replication/">Read the Redshift case study <span aria-hidden="true">→</span></a>}
</section>

<style>
  .impact { padding: 1.75rem 0 2.25rem; }
  .aws-work {
    padding: clamp(1.15rem, 3vw, 2rem);
    color: #f3f8eb;
    background: #153630;
    border: 1px solid #45675e;
    border-radius: .85rem;
    --muted: #d4e2d9;
    --accent: #c5e4a5;
  }
  .case-link { display: inline-block; margin-top: 1.1rem; color: var(--accent); font-weight: 600; }
  .case-link:focus-visible { outline-color: var(--accent); }
  .aws-work .outcomes { grid-template-columns: 1fr; gap: 1rem; }
  .aws-work summary { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  .aws-work .company { grid-column: 1 / -1; }
  .aws-work strong { font-size: clamp(1.35rem, 2vw, 1.7rem); }
  .aws-work .read { font-size: 1.4rem; line-height: 1; }
  .aws-work .read span { display: none; }
  .aws-work details { border-top: 1px solid #749487; }
  .aws-work summary:focus-visible { outline-color: #d3eea6; }
  h2 { font: 650 1rem/1.5 system-ui, sans-serif; letter-spacing: 0; margin: 0 0 1rem; }
  .outcomes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.35rem 2rem; align-items: start; }
  details { border-top: 2px solid var(--accent); }
  summary { cursor: pointer; display: grid; gap: .35rem; padding-top: .85rem; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .company { font: 600 .85rem/1.5 var(--mono); color: var(--muted); }
  strong { font: 500 clamp(1.45rem, 2.6vw, 2.1rem)/1.16 Georgia, serif; letter-spacing: -.02em; }
  .read { display: inline-flex; align-items: center; gap: .4rem; font-size: .9rem; color: var(--accent); }
  .read i::before { content: '+'; font-style: normal; }
  summary:hover .read { text-decoration: underline; }
  details[open] i::before { content: '−'; }
  .open-label, details[open] .closed-label { display: none; }
  details[open] .open-label { display: inline; }
  p { color: var(--muted); margin: .55rem 0 0; }
  @media (max-width: 40rem) { .outcomes { grid-template-columns: 1fr; gap: 1rem; } }
</style>
