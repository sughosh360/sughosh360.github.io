---
const highlights = [
  {
    company: 'AWS · Amazon Redshift',
    result: 'Restored Zero-ETL ingestion',
    detail: 'When a customer’s first data load failed, I traced the failure to two services interpreting Parquet dates and timestamps differently. I worked across teams to get ingestion running again.',
  },
  {
    company: 'AWS · Aurora MySQL',
    result: 'Fixed a slowdown in database reads',
    detail: 'I tracked a performance regression in Aurora MySQL 8.4 to the threads that handle read I/O and fixed it. I also made the maximum SQL digest length configurable across server restarts.',
  },
  {
    company: 'Eightfold AI',
    result: '5-second analytics dashboards',
    detail: 'I replaced QuickSight’s in-memory dashboards with dashboards backed by materialized views. Queries that had timed out returned in five seconds.',
  },
  {
    company: 'SAP SuccessFactors',
    result: '50% less memory for CRUD APIs',
    detail: 'I worked with two architects to rebuild the APIs that create, read, update, and delete records. The new implementation used half the memory.',
  },
];
---
<section aria-labelledby="impact-title" class="impact">
  <h2 id="impact-title">Engineering impact</h2>
  <div class="outcomes">
    {highlights.map(item => (
      <details>
        <summary>
          <span class="company">{item.company}</span>
          <strong>{item.result}</strong>
          <span class="read"><span class="closed-label">See the work</span><span class="open-label">Hide details</span><i aria-hidden="true"></i></span>
        </summary>
        <p>{item.detail}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .impact { padding: 1.75rem 0 2.25rem; }
  h2 { font: 650 1rem/1.5 system-ui, sans-serif; letter-spacing: 0; margin: 0 0 1rem; }
  .outcomes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.35rem 2rem; align-items: start; }
  details { border-top: 2px solid var(--accent); }
  summary { cursor: pointer; display: grid; gap: .35rem; padding-top: .85rem; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .company { font: 600 .85rem/1.5 var(--mono); color: var(--muted); }
  strong { font: 500 clamp(1.45rem, 2.6vw, 2.1rem)/1.16 Georgia, serif; letter-spacing: -.02em; }
  .read { display: inline-flex; align-items: center; gap: .4rem; font-size: .9rem; color: var(--accent); }
  .read i::before { content: '+'; font-style: normal; }
  summary:hover .read { text-decoration: underline; }
  details[open] i::before { content: '−'; }
  .open-label, details[open] .closed-label { display: none; }
  details[open] .open-label { display: inline; }
  p { color: var(--muted); margin: .55rem 0 0; }
  @media (max-width: 40rem) { .outcomes { grid-template-columns: 1fr; gap: 1rem; } }
</style>
