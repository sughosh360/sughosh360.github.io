---
const orders = [
  { id: 17, region: 'East', amount: 40 },
  { id: 18, region: 'West', amount: 10 },
  { id: 19, region: 'East', amount: 25 },
];
const regions = ['East', 'West'];
---
<figure class="trace">
  <figcaption>
    <span class="source">Columbia University · 2022 thesis</span>
    <strong>Trace a query result</strong>
  </figcaption>
  <fieldset>
    <legend>Choose a result</legend>
    {regions.map((region, i) => (
      <label class="choice">
        <input type="radio" name="lineage-region" value={region} checked={i === 0} />
        <span>{region}</span>
      </label>
    ))}
    {regions.map(region => {
      const matches = orders.filter(order => order.region === region);
      const total = matches.reduce((sum, order) => sum + order.amount, 0);
      return (
        <div class="diagram" data-region={region}>
          <svg viewBox="0 0 380 172" role="img" aria-label={`The ${region} total of ${total} comes from orders ${matches.map(order => order.id).join(' and ')}.`}>
            <g class="column-names"><text x="2" y="14">SOURCE ORDERS</text><text x="254" y="14">QUERY RESULT</text></g>
            {orders.map((order, i) => {
              const y = 32 + 46 * i;
              return (
                <g class:list={['record', {matched: order.region === region}]}>
                  {order.region === region && <path d={`M149 ${y + 18} C201 ${y + 18}, 202 96, 252 96`} />}
                  <rect x="2" y={y} width="147" height="36" rx="5" />
                  <text x="14" y={y+23}>{order.id} · {order.region} · {order.amount}</text>
                </g>
              );
            })}
            <rect class="sum" x="250" y="60" width="124" height="72" rx="7" />
            <text class="region" x="266" y="81">{region} total</text>
            <text class="number" x="265" y="118">{total}</text>
          </svg>
          <p>{matches.length === 1 ? 'One order contributes' : 'Two orders contribute'} to the {region} total.</p>
        </div>
      );
    })}
  </fieldset>
  <a href="/notes/lineage-in-duckdb/#physical-scan">How the lineage index works</a>
</figure>

<style>
  .trace { position: relative; margin: 0; overflow: hidden; padding: clamp(1.15rem, 3vw, 2rem); color: #f3f8eb; background-color: #102e2b; background-image: radial-gradient(#34524a .7px, transparent .9px); background-size: 13px 13px; border: 1px solid #45675e; border-top: 4px solid #b9dc88; border-radius: .85rem; box-shadow: 0 1rem 2.6rem -1.3rem #102e2b45; }
  .source, legend { color: #c7ddc9; font: 600 .78rem/1.5 var(--mono); }
  .source { display: block; text-transform: uppercase; letter-spacing: .09em; }
  figcaption strong { display: block; font: 500 clamp(1.6rem, 3vw, 2.3rem)/1.2 Georgia, serif; margin: .55rem 0 1.15rem; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { margin-bottom: .35rem; padding: 0; }
  .choice { display: inline-block; position: relative; margin-right: .3rem; cursor: pointer; }
  .choice input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .choice span { display: block; padding: .35rem .9rem; border: 1px solid #8fa79b; border-radius: 2rem; background: #1e3d34; font-size: .9rem; }
  .choice input:checked + span { background: #d3eea6; color: #17352a; border-color: #d3eea6; font-weight: 700; }
  .choice input:focus-visible + span, a:focus-visible { outline: 3px solid white; outline-offset: 3px; }
  .diagram { margin-top: 1.1rem; }
  .diagram[data-region="West"] { display: none; }
  fieldset:has(input[value="West"]:checked) .diagram[data-region="East"] { display: none; }
  fieldset:has(input[value="West"]:checked) .diagram[data-region="West"] { display: block; }
  svg { width: 100%; display: block; font-family: var(--mono); }
  .column-names, .region { fill: #c7ddc9; font-size: 12px; letter-spacing: .03em; }
  .record rect { fill: #132e29; stroke: #739287; stroke-dasharray: 3; }
  .record text { fill: #b4c6be; font-size: 14px; }
  .matched rect { fill: #2c4d40; stroke: #c5e4a5; stroke-dasharray: none; }
  .matched text { fill: #f0f8e9; }
  .record path { fill: none; stroke: #c5e4a5; stroke-width: 2; }
  .sum { fill: #d3eea6; }
  .region, .number { fill: #16392c; }
  .number { font: 500 36px Georgia, serif; }
  .diagram p { margin: 0; color: #d4e2d9; font-size: .94rem; }
  a { display: inline-block; margin-top: .85rem; color: #d3eea6; text-underline-offset: .22em; }
</style>
