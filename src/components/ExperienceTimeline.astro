---
import type { Experience } from '../data/site';

interface Props {
  items: Experience[];
}

const { items } = Astro.props;

const initials = (org: string) =>
  org
    .split(/\s+/)
    .map((w) => w[0] ?? '')
    .join('')
    .slice(0, 2)
    .toUpperCase();

// Preserve file order (newest first); group only for stable ordering of the filter chips.
const orgs = [...new Set(items.map((i) => i.org))];
const topics = [...new Set(items.flatMap((item) => item.topics))].sort();
const isCurrent = (period: string) => /present/i.test(period);
---

<div class="exp" data-timeline>
  <div class="filters" hidden role="group" aria-label="Filter experience by company">
    <button class="chip is-active" data-org="" aria-pressed="true">All</button>
    {orgs.map((org) => <button class="chip" data-org={org} aria-pressed="false">{org}</button>)}
  </div>

  <label class="topic-filter" hidden>
    Filter by topic
    <select>
      <option value="">All topics</option>
      {topics.map((topic) => <option value={topic}>{topic}</option>)}
    </select>
  </label>
  <p class="muted results" role="status"></p>

  <ol class="tl">
    {
      items.map((item) => (
        <li class="tl-item" data-org={item.org} data-topics={JSON.stringify(item.topics)}>
          <span class="dot" aria-hidden="true">{initials(item.org)}</span>
          <article class="card">
            <div class="card-top">
              <div>
                <p class="role">{item.role}</p>
                <p class="org-name muted">{item.org}</p>
              </div>
              <div class="meta">
                {isCurrent(item.period) && <span class="badge">Now</span>}
                <span class="period muted">{item.period}</span>
              </div>
            </div>
            {item.bullets.length === 1 && <p class="contributions">{item.bullets[0]}</p>}
            {item.bullets.length > 1 && (
              <ul class="contributions">
                {item.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
            <ul class="topics" aria-label="Topics">
              {item.topics.map((topic) => <li>{topic}</li>)}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>
</div>

<script>
  const root = document.querySelector('[data-timeline]');
  const filters = root?.querySelector<HTMLElement>('.filters');
  const topicLabel = root?.querySelector<HTMLLabelElement>('.topic-filter');
  const topicSelect = topicLabel?.querySelector('select');
  const results = root?.querySelector('.results');

  if (root && filters && topicLabel && topicSelect && results) {
    const chips = Array.from(filters.querySelectorAll<HTMLButtonElement>('.chip'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('.tl-item'), (element) => ({
      element,
      topics: new Set<string>(JSON.parse(element.dataset.topics ?? '[]')),
    }));
    let selectedOrg = '';

    function updateResults() {
      const topic = topicSelect?.value ?? '';
      let count = 0;
      for (const { element, topics } of items) {
        const match = (!selectedOrg || element.dataset.org === selectedOrg)
          && (!topic || topics.has(topic));
        element.hidden = !match;
        if (match) count += 1;
      }
      if (results) {
        results.textContent = count === 0
          ? 'No roles match these filters. Try a different company or topic.'
          : `${count} ${count === 1 ? 'role' : 'roles'} shown`;
      }
    }

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        selectedOrg = chip.dataset.org ?? '';
        for (const button of chips) {
          button.classList.toggle('is-active', button === chip);
          button.setAttribute('aria-pressed', String(button === chip));
        }
        updateResults();
      });
    }

    topicSelect.addEventListener('change', updateResults);
    filters.hidden = false;
    topicLabel.hidden = false;
    updateResults();
  }
</script>

<style>
  .exp {
    margin-top: 0.5rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .filters[hidden], .topic-filter[hidden] { display: none; }
  .topic-filter { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; }
  .topic-filter select {
    font: inherit;
    color: var(--fg);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: .45rem;
    padding: .35rem .65rem;
  }
  .results { margin: .65rem 0 1rem; font-size: .9rem; }
  .results:empty { display: none; }
  .topics {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: .4rem;
    padding: 0;
    margin: .75rem 0 0;
  }
  .topics li {
    padding: .15rem .55rem;
    border-radius: .35rem;
    color: var(--accent);
    background: var(--wash);
    font-size: .85rem;
  }
  .chip {
    padding: 0.35rem 0.9rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .chip:hover {
    color: var(--fg);
    border-color: var(--accent);
  }
  .chip.is-active {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }
  @media (prefers-color-scheme: dark) {
    .chip.is-active {
      color: #0c0a09;
    }
  }

  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* vertical rail */
  .tl::before {
    content: '';
    position: absolute;
    left: 1.55rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--border);
  }

  .tl-item {
    position: relative;
    padding-left: 4.25rem;
    padding-bottom: 1.9rem;
  }
  .tl-item:last-child {
    padding-bottom: 0;
  }
  .tl-item[hidden] {
    display: none;
  }

  .dot {
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 3.1rem;
    height: 3.1rem;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent);
    background: var(--bg);
    border: 2px solid var(--border);
    border-radius: 50%;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .tl-item:hover .dot,
  .tl-item:focus-within .dot {
    border-color: var(--accent);
    transform: scale(1.06);
  }

  .card {
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .tl-item:hover .card,
  .tl-item:focus-within .card {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.25);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem 1rem;
  }
  .role {
    margin: 0;
    font-weight: 600;
    font-size: 1.02rem;
  }
  .org-name {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
  }
  .meta {
    margin-left: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
  }
  .period {
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .contributions {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  ul.contributions {
    padding-inline-start: 1.2rem;
  }
  .contributions li + li {
    margin-top: 0.3rem;
  }

  @media (max-width: 560px) {
    .tl::before {
      left: 1.35rem;
    }
    .tl-item {
      padding-left: 3.6rem;
    }
    .dot {
      width: 2.7rem;
      height: 2.7rem;
      font-size: 0.72rem;
      top: 0.9rem;
    }
    .meta {
      margin-left: 0;
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .dot,
    .chip {
      transition: none;
    }
  }
</style>
