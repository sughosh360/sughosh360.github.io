---
import Base from './Base.astro';
interface Props { title: string; description: string; label: string; }
const { title, description, label } = Astro.props;
---
<Base title={`${title} | Sughosh Kaushik`} description={description} type="article">
  <article class="note">
    <a class="back" href="/#projects">← Database portfolio</a>
    <header>
      <p class="eyebrow">{label}</p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="byline">Sughosh Kaushik</p>
    </header>
    <slot />
  </article>
</Base>

<style>
  .note { max-width: 44rem; margin-inline: auto; padding-block: 2.4rem 4rem; }
  header { margin: 2.3rem 0; }
  h1 { margin: .7rem 0; font-size: clamp(2.3rem, 5.5vw, 4rem); }
  .byline, .back { font-size: .9rem; }
  .note :global(h2) { margin: 2.3rem 0 .65rem; }
  .note :global(pre) { overflow-x: auto; padding: 1rem 1.2rem; border-radius: .5rem; background: #182f33; color: #e1f3dc; font: .88rem/1.65 var(--mono); }
</style>
