---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title = site.title, description = site.description, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/share.png', Astro.site)} />
    <meta property="og:image:alt" content="Sughosh Kaushik's database field notes: DuckDB, Redshift and SQL" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="container">
        <a class="logo" href="/"><span class="monogram" aria-hidden="true">SK</span>{site.name}</a>
        <ul>
          <li><a href="/#projects">Work</a></li>
          <li><a href="/#experience">Experience</a></li>
          <li><a href="/#education">Education</a></li>
          <li><a href="/reading/">Reading</a></li>
        </ul>
        <a class="contact-link" href="/#contact">Get in touch</a>
      </nav>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="container">
      <p class="muted">&copy; {year} {site.name}</p>
    </footer>
  </body>
</html>

<style>
  .skip { position: fixed; top: .5rem; left: .5rem; z-index: 20; padding: .5rem 1rem; background: var(--card); transform: translateY(-160%); }
  .skip:focus { transform: none; }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem 1.5rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .monogram { display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; font: italic 1.1rem Georgia, serif; letter-spacing: -.08em; color: var(--on-accent); background: var(--accent); }
  .logo { display: inline-flex; align-items: center; gap: .65rem;
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .45rem 1.05rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }
  ul a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  ul a:hover {
    color: var(--fg);
  }
  .contact-link { display: inline-block; text-decoration: none; border-bottom: 2px solid var(--accent); color: var(--accent); font-weight: 650; }
  @media (max-width: 42rem) {
    nav { display: grid; grid-template-columns: 1fr auto; gap: .25rem .5rem; }
    .contact-link { grid-column: 2; grid-row: 1; }
    nav ul { grid-column: 1 / -1; grid-row: 2; margin: 0; gap: .35rem .85rem; }
    nav ul a { display: inline-block; padding-block: .15rem; }
  }
  footer {
    padding-top: 2rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
</style>
